Options -Indexes
DirectoryIndex index.php

<FilesMatch "(?i)^(config(?:\.example)?\.php|schema\.sql|migrate-v[0-9]+\.sql|composer\.(?:json|lock)|README\.md|\.env(?:\..*)?)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^webhook/?$ webhook.php [L,NC]
RewriteRule ^vendor(?:/|$) - [F,L,NC]
RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F,L,NC]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
